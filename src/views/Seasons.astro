---
import Base from '../layouts/Base.astro';
import StockBadge from '../components/StockBadge.astro';
import MonthStrip from '../components/MonthStrip.astro';
import { href, routePath, t, type Lang } from '../i18n/ui';
import { getSpecies, overallStock } from '../lib/species';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const species = await getSpecies(lang);
const monthNames = t(lang, 'months.short').split(',');
const phases = [
  { when: t(lang, 'seasons.phase1.when'), title: t(lang, 'seasons.phase1.title'), body: t(lang, 'seasons.phase1.body') },
  { when: t(lang, 'seasons.phase2.when'), title: t(lang, 'seasons.phase2.title'), body: t(lang, 'seasons.phase2.body') },
  { when: t(lang, 'seasons.phase3.when'), title: t(lang, 'seasons.phase3.title'), body: t(lang, 'seasons.phase3.body') },
];
---

<Base
  lang={lang}
  title={t(lang, 'seasons.title')}
  description={t(lang, 'seasons.intro')}
  route="seasons"
  alternates={{ es: routePath('es', 'seasons'), en: routePath('en', 'seasons') }}
>
  <section class="section">
    <div class="container">
      <h1>{t(lang, 'seasons.title')}</h1>
      <p class="lead">{t(lang, 'seasons.intro')}</p>

      <div class="grid phases">
        {
          phases.map((p) => (
            <div class="card">
              <p class="when">{p.when}</p>
              <p class="phase-title">{p.title}</p>
              <p class="phase-body">{p.body}</p>
            </div>
          ))
        }
      </div>

      <ul class="season-list">
        {
          species.map((s) => (
            <li class="card">
              <div class="season-head">
                <a href={href(lang, 'species', s.id)}>{s.data.name[lang]}</a>
                <StockBadge stock={overallStock(s)} lang={lang} />
              </div>
              <MonthStrip months={s.data.months} lang={lang} />
            </li>
          ))
        }
      </ul>

      <div class="table-wrap card">
        <table>
          <caption class="visually-hidden">{t(lang, 'seasons.tableCaption')}</caption>
          <thead>
            <tr>
              <th scope="col" class="left">{t(lang, 'seasons.species')}</th>
              {monthNames.map((m, i) => <th scope="col" data-month={i + 1}>{m}</th>)}
              <th scope="col" class="left">{t(lang, 'seasons.stock')}</th>
            </tr>
          </thead>
          <tbody>
            {
              species.map((s) => (
                <tr>
                  <th scope="row" class="left">
                    <a href={href(lang, 'species', s.id)}>{s.data.name[lang]}</a>
                  </th>
                  {monthNames.map((m, i) => (
                    <td>
                      <span class:list={['cell', { on: s.data.months.includes(i + 1) }]}>
                        <span class="visually-hidden">
                          {m}: {s.data.months.includes(i + 1) ? '✓' : '—'}
                        </span>
                      </span>
                    </td>
                  ))}
                  <td class="left">
                    <StockBadge stock={overallStock(s)} lang={lang} />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .phases {
    margin: 2rem 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .when {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0;
  }

  .phase-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
  }

  .phase-body {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  /* Phones: one card per species with its month strip. Tablet and up: the full table. */
  .season-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .season-list li {
    padding: 1rem;
  }

  .season-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .season-head a {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--color-ink);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .table-wrap {
    display: none;
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
  }

  @media (min-width: 48rem) {
    .season-list {
      display: none;
    }

    .table-wrap {
      display: block;
    }
  }

  table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 0.4rem 0.25rem;
    text-align: center;
  }

  thead th {
    font-weight: 500;
  }

  thead th.current {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
  }

  .left {
    text-align: left;
    padding-inline: 0.5rem;
  }

  tbody tr {
    border-top: 1px solid var(--color-border);
  }

  tbody th a {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  tbody th a:hover {
    color: var(--color-primary);
  }

  .cell {
    display: block;
    height: 1.5rem;
    border-radius: 0.35rem;
    background: var(--color-muted-bg);
  }

  .cell.on {
    background: var(--color-primary);
  }
</style>

<script>
  // Highlight the current month (done in the browser so it stays right after the build).
  const month = new Date().getMonth() + 1;
  document.querySelector(`thead th[data-month="${month}"]`)?.classList.add('current');
</script>
