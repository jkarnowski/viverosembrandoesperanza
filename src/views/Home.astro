---
import Base from '../layouts/Base.astro';
import SpeciesCard from '../components/SpeciesCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
import { team } from '../data/team';
import { site, whatsappLink } from '../data/site';
import { href, routePath, t, url, type Lang } from '../i18n/ui';
import { getSpecies } from '../lib/species';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const featured = (await getSpecies(lang)).filter((s) => s.data.featured).slice(0, 3);
---

<Base lang={lang} alternates={{ es: routePath('es', 'home'), en: routePath('en', 'home') }}>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">{t(lang, 'site.tagline')}</p>
      <h1>{t(lang, 'home.hero.title')}</h1>
      <p class="lead">{t(lang, 'home.hero.body')}</p>
      <div class="button-row">
        <a class="button" href={href(lang, 'species')}>{t(lang, 'home.hero.cta')}</a>
        <a class="button button--ghost" href={href(lang, 'contact')}>{t(lang, 'home.hero.cta2')}</a>
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container">
      <div class="section-head">
        <h2>{t(lang, 'home.featured.title')}</h2>
        <a href={href(lang, 'species')}>{t(lang, 'home.featured.all')} →</a>
      </div>
      <div class="grid trees">
        {featured.map((species) => <SpeciesCard species={species} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt compact">
    <div class="container">
      <div class="section-head">
        <h2>{t(lang, 'home.services.title')}</h2>
        <a href={href(lang, 'services')}>{t(lang, 'home.services.more')} →</a>
      </div>
      <div class="grid services">
        {
          services.map((s) => (
            <ServiceCard
              title={t(lang, s.title)}
              body={t(lang, s.body)}
              points={t(lang, s.points)}
              icon={s.icon}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container family">
      <div class="faces" aria-hidden="true">
        {
          team
            .filter((m) => m.photo)
            .map((m) => <img src={url(`team/${m.photo}`)} alt="" width="160" height="160" loading="lazy" />)
        }
      </div>
      <div>
        <p class="eyebrow">{t(lang, 'home.family.eyebrow')}</p>
        <h2>{t(lang, 'home.family.title')}</h2>
        <p class="lead">{t(lang, 'home.family.body')}</p>
        <a href={href(lang, 'about')}>{t(lang, 'home.family.cta')} →</a>
      </div>
    </div>
  </section>

  <section class="section section--alt compact">
    <div class="container visit">
      <div>
        <h2>{t(lang, 'home.quote.title')}</h2>
        <p class="lead">{t(lang, 'home.quote.body')}</p>
      </div>
      <div class="button-row">
        <a class="button" href={whatsappLink(t(lang, 'services.ctaMessage'))} rel="noopener">
          {t(lang, 'services.cta')}
        </a>
        <a class="button button--ghost" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 4.5rem);
    background:
      radial-gradient(60rem 30rem at 85% 0%, color-mix(in srgb, var(--color-primary) 16%, transparent), transparent 70%),
      radial-gradient(40rem 24rem at 0% 100%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent 70%);
  }

  .hero-inner > * {
    max-width: 46rem;
  }

  .hero .lead {
    margin-bottom: 1.5rem;
  }

  /* Tighter vertical rhythm on the landing page. */
  .compact {
    padding-block: clamp(2rem, 5vw, 3.25rem);
  }

  .trees {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .trees :global(.art) {
    aspect-ratio: 16 / 9;
  }

  .services {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .family {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .family {
      grid-template-columns: auto 1fr;
      gap: 3rem;
    }
  }

  .faces {
    display: flex;
  }

  .faces img {
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-bg);
  }

  .faces img + img {
    margin-left: -1.5rem;
  }

  .family .lead {
    margin-bottom: 1rem;
  }

  .visit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .visit .lead {
    margin: 0;
  }
</style>
