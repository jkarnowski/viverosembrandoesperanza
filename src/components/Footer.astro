---
import { site, whatsappLink } from '../data/site';
import { href, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="name">{site.name}</p>
      <p class="soft">{t(lang, 'footer.about')}</p>
    </div>
    <div>
      <p class="heading">{t(lang, 'footer.season')}</p>
      <p class="soft">{t(lang, 'footer.seasonBody')}</p>
      <p class="heading">{t(lang, 'nav.contact')}</p>
      <p class="soft">
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={`tel:+${site.whatsapp}`}>{site.phone}</a>
      </p>
    </div>
    <div>
      <p class="heading">{t(lang, 'nav.menu')}</p>
      <p class="soft">
        <a href={href(lang, 'species')}>{t(lang, 'nav.species')}</a><br />
        <a href={href(lang, 'seasons')}>{t(lang, 'nav.seasons')}</a><br />
        <a href={href(lang, 'services')}>{t(lang, 'nav.services')}</a><br />
        <a href={href(lang, 'about')}>{t(lang, 'nav.about')}</a><br />
        <a href={site.instagram} rel="noopener">Instagram</a>
      </p>
      <a class="wa" href={whatsappLink(t(lang, 'contact.whatsappMessage'))} rel="noopener">{t(lang, 'contact.whatsapp')}</a>
    </div>
  </div>
  <div class="container legal">
    <small>© {year} {site.name}. {t(lang, 'footer.rights')}</small>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding-block: 3rem 1.5rem;
  }

  @media (max-width: 47.99rem) {
    .site-footer {
      padding-bottom: 5.5rem;
    }
  }

  .cols {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .heading {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .soft {
    opacity: 0.85;
    font-size: 0.95rem;
  }

  a {
    color: inherit;
  }

  a:hover {
    color: inherit;
    opacity: 1;
  }

  .wa {
    display: inline-flex;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--color-on-primary);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .wa:hover {
    color: var(--color-primary-strong);
  }

  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-primary) 20%, transparent);
    opacity: 0.75;
  }
</style>
