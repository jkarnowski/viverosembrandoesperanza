---
import { site } from '../data/site';
import { href, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="name">{site.name}</p>
      <p>{t(lang, 'site.tagline')}</p>
    </div>
    <div>
      <p class="heading">{t(lang, 'nav.contact')}</p>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={`tel:+${site.whatsapp}`}>{site.phone}</a><br />
        {site.address.city}
      </p>
    </div>
    <div>
      <p class="heading">{t(lang, 'nav.menu')}</p>
      <p>
        <a href={href(lang, 'species')}>{t(lang, 'nav.species')}</a><br />
        <a href={href(lang, 'services')}>{t(lang, 'nav.services')}</a><br />
        <a href={href(lang, 'about')}>{t(lang, 'nav.about')}</a><br />
        <a href={site.instagram} rel="noopener">Instagram</a>
      </p>
    </div>
  </div>
  <div class="container legal">
    <small>© {year} {site.name}. {t(lang, 'footer.rights')}</small>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--color-primary-strong);
    color: #e7efe8;
    padding-block: 3rem 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .site-footer {
      background: #0e1410;
    }
  }

  .cols {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
  }

  .heading {
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  a {
    color: #cfe3d3;
  }

  a:hover {
    color: #fff;
  }

  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 15%);
    color: #b9c9bd;
  }
</style>
