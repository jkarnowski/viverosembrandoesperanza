---
import Logo from './Logo.astro';
import { enabledLangs, href, languages, t, url, type Lang, type Route } from '../i18n/ui';

interface Props {
  lang: Lang;
  route?: Route;
  alternates: Record<Lang, string>;
}

const { lang, route, alternates } = Astro.props;
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const nav: { route: Route; label: string }[] = [
  { route: 'species', label: t(lang, 'nav.species') },
  { route: 'about', label: t(lang, 'nav.about') },
  { route: 'contact', label: t(lang, 'nav.contact') },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href(lang, 'home')}>
      <Logo />
      <span>{t(lang, 'site.title')}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      {t(lang, 'nav.menu')}
    </button>

    <nav id="site-nav" aria-label={t(lang, 'nav.menu')}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={href(lang, item.route)} aria-current={item.route === route ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          enabledLangs.includes(otherLang) && (
            <li>
              <a class="lang" href={url(alternates[otherLang])} hreflang={otherLang} lang={otherLang}>
                {languages[otherLang]}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header.js .bar {
    flex-wrap: nowrap;
  }

  .bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 3.6vw, 1.15rem);
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand :global(svg) {
    flex-shrink: 0;
  }

  .menu-toggle {
    flex-shrink: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--color-surface-alt);
    color: var(--color-primary-strong);
  }

  .lang {
    border: 1px solid var(--color-border);
    margin-left: 0.5rem;
    font-size: 0.9rem;
  }

  .menu-toggle {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  /* Narrow screens: once the script has run, the nav collapses behind the toggle.
     Without JavaScript the nav simply wraps below the brand. */
  @media (max-width: 47.99rem) {
    .site-header.js nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow);
      padding: 0.5rem var(--gutter) 1rem;
    }

    .site-header.js.open nav {
      display: block;
    }

    .site-header.js ul {
      flex-direction: column;
      align-items: stretch;
    }

    .site-header.js nav a {
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
    }

    .site-header.js .lang {
      margin: 0.5rem 0 0;
      text-align: center;
    }
  }

  @media (min-width: 48rem) {
    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  if (header && toggle) {
    header.classList.add('js');
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('open')) {
        header.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>
