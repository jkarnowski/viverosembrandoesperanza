---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const reasons = [
  { title: t(lang, 'home.why.water.title'), body: t(lang, 'home.why.water.body'), icon: 'M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11Z' },
  { title: t(lang, 'home.why.wildlife.title'), body: t(lang, 'home.why.wildlife.body'), icon: 'M4 14c4-1 6-4 7-8 1 4 3 7 9 8-6 1-8 3-9 6-1-3-3-5-7-6Z' },
  { title: t(lang, 'home.why.soil.title'), body: t(lang, 'home.why.soil.body'), icon: 'M3 18h18M6 18c0-4 2.5-7 6-7s6 3 6 7M12 11V4m0 3c-2 0-3.5-1.3-3.5-3.2 2 0 3.5 1.3 3.5 3.2Z' },
];
---

<section class="why">
  <h2>{t(lang, 'home.why.title')}</h2>
  <div class="reasons">
    {
      reasons.map((r) => (
        <div class="reason">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d={r.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .reasons {
    display: grid;
    gap: 1rem;
  }

  .reason {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
  }

  svg {
    flex-shrink: 0;
    color: var(--color-primary);
    margin-top: 0.1rem;
  }

  h3 {
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
