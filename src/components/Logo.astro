---
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
  class="logo"
>
  <circle cx="16" cy="16" r="15" fill="var(--color-primary)"></circle>
  <path
    d="M16 25V14m0 3c-3.5 0-6-2.4-6-6 3.5 0 6 2.4 6 6Zm0-2c0-3.8 2.6-6.5 6.5-6.5 0 3.8-2.6 6.5-6.5 6.5Z"
    fill="none"
    stroke="var(--color-on-primary)"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
