---
import SpeciesArt from './SpeciesArt.astro';
import StockBadge from './StockBadge.astro';
import { href, t, type Lang } from '../i18n/ui';
import { formatHeight, overallStock, type Species } from '../lib/species';

interface Props {
  species: Species;
  lang: Lang;
}

const { species, lang } = Astro.props;
const { data } = species;
const meta = [
  t(lang, `leaf.${data.leaf}`),
  formatHeight(data.height),
  `${t(lang, 'species.growth')} ${t(lang, `growth.${data.growth}`).toLowerCase()}`,
  `${t(lang, 'species.water')} ${t(lang, `water.${data.water}`).toLowerCase()}`,
];
---

<article class="species-card" data-climate={data.climate.join(' ')}>
  <a href={href(lang, 'species', species.id)}>
    <div class="media">
      <SpeciesArt color={data.color} label={`${data.name[lang]} (${data.scientificName})`} photo={data.photo} />
      <span class="stock"><StockBadge stock={overallStock(species)} lang={lang} /></span>
    </div>
    <div class="body">
      <h3>{data.name[lang]}</h3>
      <p class="sci">{data.scientificName}</p>
      <p class="meta">{meta.join(' · ')}</p>
      {data.conservation && <p class="status">{t(lang, `conservation.${data.conservation}`)}</p>}
    </div>
  </a>
</article>

<style>
  .species-card {
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.2s;
  }

  .species-card:hover {
    transform: translateY(-4px);
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .media {
    position: relative;
    overflow: hidden;
  }

  .stock {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    box-shadow: 0 4px 14px -6px oklch(0.2 0.03 150 / 0.5);
    border-radius: 999px;
  }

  .media :global(.art) {
    transition: transform 0.5s;
  }

  .species-card:hover .media :global(.art) {
    transform: scale(1.05);
  }

  .body {
    padding: 1.1rem 1.25rem 1.25rem;
  }

  h3 {
    margin-bottom: 0.1rem;
  }

  .sci {
    font-style: italic;
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .meta {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .status {
    display: inline-block;
    margin: 0.6rem 0 0;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-warning) 25%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
