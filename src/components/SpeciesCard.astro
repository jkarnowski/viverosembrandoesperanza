---
import SpeciesArt from './SpeciesArt.astro';
import { href, t, type Lang } from '../i18n/ui';
import { formatHeight, type Species } from '../lib/species';

interface Props {
  species: Species;
  lang: Lang;
}

const { species, lang } = Astro.props;
const { data } = species;
---

<article class="species-card" data-climate={data.climate.join(' ')}>
  <a href={href(lang, 'species', species.id)}>
    <SpeciesArt color={data.color} label={data.name[lang]} />
    <div class="body">
      <h3>{data.name[lang]}</h3>
      <p class="sci">{data.scientificName}</p>
      <p class="summary">{data.summary[lang]}</p>
      <ul class="tags">
        <li>{formatHeight(data.height)}</li>
        <li>{t(lang, `sun.${data.sun}`)}</li>
        <li>{t(lang, 'species.water')}: {t(lang, `water.${data.water}`).toLowerCase()}</li>
        {data.conservation && <li class="status">{t(lang, `conservation.${data.conservation}`)}</li>}
        {!data.available && <li class="status">{t(lang, 'species.unavailable')}</li>}
      </ul>
    </div>
  </a>
</article>

<style>
  .species-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .species-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .body {
    padding: 1.1rem 1.25rem 1.3rem;
  }

  h3 {
    margin-bottom: 0.1rem;
  }

  .sci {
    font-style: italic;
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }

  .summary {
    font-size: 0.98rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }

  .tags li {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-muted);
  }

  .tags .status {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    color: var(--color-ink);
  }
</style>
