---
// The species photo, or a tinted panel with a leaf motif when there is none yet.
import { url } from '../i18n/ui';

interface Props {
  color: string;
  label: string;
  photo?: string;
  class?: string;
  /** Load the photo right away (for images near the top of the page). */
  eager?: boolean;
}

const { color, label, photo, class: className, eager = false } = Astro.props;
---

{
  photo ? (
    <img
      class:list={['art', 'art--photo', className]}
      src={url(`photos/${photo}`)}
      alt={label}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div class:list={['art', className]} style={`--tint: ${color}`} role="img" aria-label={label}>
      <svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.55">
          <path d="M60 72V30" />
          <path d="M60 52c-12 0-20-8-20-20 12 0 20 8 20 20Z" />
          <path d="M60 44c0-13 9-22 22-22 0 13-9 22-22 22Z" />
          <path d="M60 34c-6-6-6-15 0-22 6 7 6 16 0 22Z" />
        </g>
      </svg>
    </div>
  )
}

<style>
  .art {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 22%), transparent 60%),
      var(--tint);
    color: #fff;
  }

  .art--photo {
    display: block;
    object-fit: cover;
    background: var(--color-muted-bg);
  }

  svg {
    width: 55%;
    max-width: 12rem;
  }
</style>
