---
// Placeholder artwork until real photos are added: a tinted panel with a leaf motif.
interface Props {
  color: string;
  label: string;
  class?: string;
}

const { color, label, class: className } = Astro.props;
---

<div class:list={['art', className]} style={`--tint: ${color}`} role="img" aria-label={label}>
  <svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.55">
      <path d="M60 72V30"></path>
      <path d="M60 52c-12 0-20-8-20-20 12 0 20 8 20 20Z"></path>
      <path d="M60 44c0-13 9-22 22-22 0 13-9 22-22 22Z"></path>
      <path d="M60 34c-6-6-6-15 0-22 6 7 6 16 0 22Z"></path>
    </g>
  </svg>
</div>

<style>
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 22%), transparent 60%),
      var(--tint);
    color: #fff;
  }

  svg {
    width: 55%;
    max-width: 12rem;
  }
</style>
