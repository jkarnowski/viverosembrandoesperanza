---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickContact from '../components/QuickContact.astro';
import { defaultLang, enabledLangs, t, url, type Lang, type Route } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Section this page belongs to, for highlighting the nav. */
  route?: Route;
  /** Site-relative path of this page in each language, for the language switch and hreflang. */
  alternates: Record<Lang, string>;
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { lang, title, description = t(lang, 'site.description'), route, alternates, noindex = false } = Astro.props;
const siteTitle = t(lang, 'site.title');
const fullTitle = title ? `${title} · ${siteTitle}` : `${siteTitle} · ${t(lang, 'site.tagline')}`;
const absolute = (path: string) => new URL(url(path), Astro.site).href;
const canonical = absolute(alternates[lang]);
const multilingual = enabledLangs.length > 1;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      multilingual &&
        enabledLangs.map((code) => (
          <link rel="alternate" hreflang={code} href={absolute(alternates[code])} />
        ))
    }
    {multilingual && <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLang])} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#2f5d3a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_US'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} route={route} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <QuickContact lang={lang} />
  </body>
</html>
